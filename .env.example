# פרטי ההתחברות לקומקס — העתק קובץ זה ל-.env ומלא את הערכים.
# הקובץ .env נמצא ב-.gitignore ולא נשלח לשום מקום.
# שלושת השדות הם בדיוק אלה שבמסך ההתחברות: ארגון / משתמש / סיסמה.

COMAX_ORG=
COMAX_USER=
COMAX_PASS=


# ---------------------------------------------------------------------------
# אפליקציית ההזמנות (npm run orders) — ראה orders-app/README.md
# ---------------------------------------------------------------------------

# WooCommerce → הגדרות → מתקדם → REST API → הוספת מפתח.
# הרשאות: קריאה/כתיבה — נדרש כדי לשנות סטטוס מהטלפון.
# המפתח והסוד מוצגים פעם אחת בלבד.
WOO_URL=https://arenaisrael.co.il
WOO_KEY=
WOO_SECRET=

# בוט טלגרם: @BotFather → /newbot → הטוקן שהוא מחזיר.
# אחרי שלוחצים Start בבוט — `npm run orders -- chat-id` מדפיס את המזהה.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# סיסמת הכניסה לממשק. מחרוזת ארוכה ואקראית — הכתובת יוצאת לאינטרנט
# דרך המנהרה, ומאחוריה שמות וטלפונים של לקוחות.
ORDERS_TOKEN=

# כתובת המנהרה. משמשת לקישור "פתיחת ההזמנה" שבתוך הודעת הטלגרם.
ORDERS_PUBLIC_URL=

# ברירות מחדל — אין צורך לשנות.
# ORDERS_PORT=4180
# ORDERS_POLL_SECONDS=60
